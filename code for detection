import cv2
from ultralytics import YOLO

# 1. Load the YOLOv8 Nano model (smallest and fastest for webcams)
model = YOLO("yolov8n.pt")

def detect_objects(frame):
    """
    Processes a single frame, detects objects, and draws bounding boxes.
    """
    results = model(frame)
    detected_objects = []

    for r in results:
        for box in r.boxes:
            class_id = int(box.cls[0])  # Get class ID
            confidence = box.conf[0].item()  # Confidence score (0.0 to 1.0)

            # Filter results with a confidence threshold (e.g., 50%)
            if confidence > 0.5:
                label = model.names[class_id]
                detected_objects.append(label)

                # Get coordinates for the bounding box
                x1, y1, x2, y2 = map(int, box.xyxy[0])

                # Draw the rectangle and the label on the frame
                cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)
                cv2.putText(frame, f"{label} {confidence:.2f}", (x1, y1 - 10),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 255, 0), 2)

    return frame, detected_objects

def main():
    # 2. Initialize the webcam (0 is usually the default camera)
    cap = cv2.VideoCapture(0, cv2.CAP_DSHOW)

    if not cap.isOpened():
        print("Error: Could not open webcam. Try changing the index to 1 or checking permissions.")
        return

    print("AI Vision Started. Press 'q' to quit.")

    while True:
        # 3. Capture frame-by-frame
        ret, frame = cap.read()
        if not ret:
            print("Error: Failed to capture image from camera.")
            break

        # 4. Run detection
        frame, detected_objects = detect_objects(frame)

        # 5. Display the resulting frame
        cv2.imshow("AI Vision Detection", frame)

        if detected_objects:
            print("Detected:", ", ".join(detected_objects))

        # 6. Exit loop if 'q' is pressed
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    # 7. Cleanup: Release the camera and close all windows
    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
